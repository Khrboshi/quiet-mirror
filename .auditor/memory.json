{
  "version": "1.0",
  "app": {
    "name": "quiet-mirror",
    "url": "https://quietmirror.me",
    "stack": "Next.js + Supabase + Vercel",
    "middlewarePattern": "res-variable",
    "packageManager": "npm",
    "nodeVersion": "24.x"
  },
  "knownServices": [
    "supabase.co",
    "anthropic.com",
    "posthog.com",
    "fonts.googleapis.com",
    "fonts.gstatic.com",
    "vercel.live",
    "va.vercel-scripts.com"
  ],
  "cspPolicy": {
    "default-src": [
      "'self'"
    ],
    "script-src": [
      "'self'",
      "'unsafe-inline'",
      "'unsafe-eval'",
      "https://vercel.live"
    ],
    "style-src": [
      "'self'",
      "'unsafe-inline'",
      "https://fonts.googleapis.com"
    ],
    "connect-src": [
      "'self'",
      "https://*.supabase.co",
      "https://api.anthropic.com",
      "https://*.posthog.com",
      "https://fonts.googleapis.com",
      "https://vercel.live"
    ],
    "img-src": [
      "'self'",
      "data:",
      "blob:"
    ],
    "font-src": [
      "'self'",
      "https://fonts.gstatic.com"
    ],
    "frame-src": [
      "'self'",
      "https://vercel.live"
    ],
    "frame-ancestors": [
      "'none'"
    ]
  },
  "successfulFixes": {
    "error-boundaries": {
      "file": "app/error.tsx",
      "date": "2026-08-27",
      "title": "Users see a blank page when something goes wrong",
      "buildTime": "~40s"
    },
    "global-error": {
      "file": "app/global-error.tsx",
      "date": "2026-08-27",
      "title": "Root layout crashes still show a blank page",
      "buildTime": "~40s"
    },
    "permissions-policy": {
      "file": "middleware.ts",
      "date": "2026-08-27",
      "title": "Browser features like camera and microphone are not explicitly disabled",
      "buildTime": "~40s"
    }
  },
  "failedAttempts": {},
  "appliedFindings": [
    "error-boundaries",
    "global-error",
    "permissions-policy"
  ],
  "auditHistory": [
    {
      "date": "2026-08-27",
      "finding": "permissions-policy",
      "outcome": "merged"
    },
    {
      "date": "2026-08-27",
      "finding": "global-error",
      "outcome": "merged"
    },
    {
      "date": "2026-08-27",
      "finding": "error-boundaries",
      "outcome": "merged"
    }
  ],
  "lastUpdated": "2026-08-27"
}
